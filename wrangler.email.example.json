{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "email-receiver-worker",
  "compatibility_date": "2024-03-20",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "workers/email-receiver.ts",
  "d1_databases": [
    {
      "binding": "DB",
      "migrations_dir": "drizzle",
      "database_name": "nextmail-d1",
      "database_id": "__DATABASE_ID__"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "SITE_CONFIG",
      "id": "__KV_NAMESPACE_ID__"
    }
  ]
}
