{
  "name": "nextmail",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "build:worker": "tsx scripts/deploy/validate-build-env.ts && opennextjs-cloudflare build && tsx scripts/deploy/validate-worker-build.ts",
    "preview:worker": "npm run build:worker && opennextjs-cloudflare preview",
    "deploy:worker": "npm run build:worker && opennextjs-cloudflare deploy",
    "db:migrate-local": "tsx scripts/migrate.ts local",
    "db:migrate-remote": "tsx scripts/migrate.ts remote",
    "webhook-test-server": "tsx scripts/webhook-test-server.ts",
    "generate:icons": "node scripts/generate-icons.mjs",
    "generate-test-data": "wrangler dev scripts/generate-test-data.ts",
    "dev:cleanup": "wrangler dev --config wrangler.cleanup.json --test-scheduled",
    "test:cleanup": "curl http://localhost:8787/__scheduled",
    "deploy:email": "wrangler deploy --config wrangler.email.json",
    "deploy:cleanup": "wrangler deploy --config wrangler.cleanup.json",
    "deploy": "tsx scripts/deploy/index.ts",
    "delete": "tsx scripts/deploy/delete.ts",
    "test": "node --import tsx --experimental-test-module-mocks --test tests/*.test.ts"
  },
  "type": "module",
  "dependencies": {
    "@auth/drizzle-adapter": "^1.11.3",
