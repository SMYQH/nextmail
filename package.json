    "@radix-ui/react-tooltip": "^1.2.16",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^0.468.0",
    "nanoid": "^5.1.16",
    "next": "15.5.27",
