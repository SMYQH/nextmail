    "next-intl": "^4.13.7",
    "next-themes": "^0.2.1",
    "postal-mime": "^2.7.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.25.76",
    "zustand": "^5.0.15",
