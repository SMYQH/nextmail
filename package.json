{
  "name": "nextmail",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "tsx scripts/deploy/generate-wrangler-config.ts",
    "dev": "node --import tsx --import ./scripts/deploy/preload-app-env.ts ./node_modules/next/dist/bin/next dev --webpack",
    "prebuild": "tsx scripts/deploy/prepare-next-build.ts",
    "build": "node --import tsx --import ./scripts/deploy/preload-app-env.ts ./node_modules/next/dist/bin/next build --webpack",
    "start": "node --import tsx --import ./scripts/deploy/preload-app-env.ts ./node_modules/next/dist/bin/next start",
    "lint": "eslint app --ext .js,.jsx,.ts,.tsx,.mjs,.cjs --max-warnings 0",
    "prebuild:worker": "tsx scripts/deploy/generate-wrangler-config.ts",
    "build:worker": "node --import tsx --import ./scripts/deploy/preload-app-env.ts ./node_modules/@opennextjs/cloudflare/dist/cli/index.js build && tsx scripts/deploy/validate-worker-build.ts",
    "preview:worker": "npm run build:worker && node --import tsx ./scripts/deploy/preview-worker.ts",
    "deploy:worker": "npm run build:worker && node --import tsx --import ./scripts/deploy/preload-app-env.ts ./node_modules/@opennextjs/cloudflare/dist/cli/index.js deploy",
    "predb:migrate-local": "tsx scripts/deploy/generate-wrangler-config.ts",
    "db:migrate-local": "tsx scripts/migrate.ts local",
    "predb:migrate-remote": "tsx scripts/deploy/generate-wrangler-config.ts",
    "db:migrate-remote": "tsx scripts/migrate.ts remote",
    "webhook-test-server": "tsx scripts/webhook-test-server.ts",
    "generate:icons": "node scripts/generate-icons.mjs",
    "pregenerate-test-data": "tsx scripts/deploy/generate-wrangler-config.ts",
    "generate-test-data": "node --import tsx --import ./scripts/deploy/preload-local-wrangler.ts ./node_modules/wrangler/bin/wrangler.js dev scripts/generate-test-data.ts",
    "predev:cleanup": "tsx scripts/deploy/generate-wrangler-config.ts",
    "dev:cleanup": "node --import tsx --import ./scripts/deploy/preload-local-wrangler.ts ./node_modules/wrangler/bin/wrangler.js dev --config wrangler.cleanup.json --test-scheduled",
    "test:cleanup": "curl http://localhost:8787/__scheduled",
    "predeploy:email": "tsx scripts/deploy/generate-wrangler-config.ts",
    "deploy:email": "node --import tsx --import ./scripts/deploy/load-env.ts ./node_modules/wrangler/bin/wrangler.js deploy --config wrangler.email.json",
    "predeploy:cleanup": "tsx scripts/deploy/generate-wrangler-config.ts",
    "deploy:cleanup": "node --import tsx --import ./scripts/deploy/load-env.ts ./node_modules/wrangler/bin/wrangler.js deploy --config wrangler.cleanup.json",
    "predeploy": "tsx scripts/deploy/generate-wrangler-config.ts",
    "deploy": "tsx scripts/deploy/index.ts",
    "verify:waf": "tsx scripts/deploy/verify-waf.ts",
    "predelete": "tsx scripts/deploy/generate-wrangler-config.ts",
    "delete": "tsx scripts/deploy/delete.ts",
    "test": "node --import tsx --experimental-test-module-mocks --test tests/*.test.ts",
    "pretest:browser": "tsx scripts/deploy/generate-wrangler-config.ts",
    "test:browser": "playwright test",
    "test:browser:isolated": "node tests/browser/run-isolated.mjs",
    "test:browser:install": "playwright install chromium",
    "bootstrap": "node scripts/bootstrap-local.mjs",
    "config:wrangler": "tsx scripts/deploy/generate-wrangler-config.ts",
    "config:migrate-local": "node scripts/migrate-local-config.mjs",
    "agent:status": "tsx scripts/agent/loop.ts status",
    "agent:next": "tsx scripts/agent/loop.ts next",
    "agent:claim": "tsx scripts/agent/loop.ts claim",
    "agent:complete": "tsx scripts/agent/loop.ts complete",
    "agent:fail": "tsx scripts/agent/loop.ts fail",
    "agent:block": "tsx scripts/agent/loop.ts block",
    "agent:unblock": "tsx scripts/agent/loop.ts unblock",
    "agent:gate": "tsx scripts/agent/loop.ts gate",
    "agent:commit": "tsx scripts/agent/loop.ts commit",
    "agent:log": "tsx scripts/agent/loop.ts log",
    "agent:enqueue": "tsx scripts/agent/loop.ts enqueue",
    "agent:branch": "tsx scripts/agent/loop.ts branch"
  },
  "type": "module",
  "dependencies": {
    "@auth/drizzle-adapter": "^1.11.3",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toast": "^1.2.23",
    "@radix-ui/react-tooltip": "^1.2.16",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "dompurify": "3.4.17",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^0.468.0",
    "nanoid": "^5.1.16",
    "next": "16.4.5",
    "next-auth": "5.0.0-beta.32",
    "next-intl": "^4.13.7",
    "next-themes": "^0.2.1",
    "postal-mime": "^2.7.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260924.1",
    "@opennextjs/cloudflare": "1.20.16",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "cloudflare": "^4.1.0",
    "dotenv": "^16.4.7",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.25.12",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "libsodium-wrappers": "^0.8.4",
    "postcss": "^8.5.29",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "wrangler": "4.149.0"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "@swc/core@1.15.47": true,
    "esbuild@0.14.47": true,
    "esbuild@0.15.18": true,
    "esbuild@0.18.20": true,
    "esbuild@0.19.12": true,
    "esbuild@0.25.4": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true,
    "esbuild@0.28.2": true,
    "sharp@0.33.5": true,
    "sharp@0.34.5": true,
    "sharp@0.35.5": true,
    "unrs-resolver@1.12.2": true,
    "workerd@1.20241218.0": true,
    "workerd@1.20260918.1": true,
    "workerd@1.20261006.1": true
  },
  "overrides": {
    "next": {
      "postcss": "$postcss",
      "sharp": "^0.35.5"
    },
    "tar": "^7.5.22",
    "path-to-regexp@6": "^6.3.0",
    "ajv@8": "^8.20.0",
    "@tootallnate/once": "^2.0.1",
    "postcss-selector-parser@6": "^7.1.6",
    "brace-expansion@1": "^1.1.21",
    "brace-expansion@2": "^2.1.7",
    "brace-expansion@5": "^5.0.12",
    "source-map-js": "^1.2.2",
    "eslint-import-resolver-typescript@3": "^3.10.1",
    "undici@<6.28.1": "^6.28.1",
    "esbuild@<0.25.0": "^0.25.12"
  }
}
