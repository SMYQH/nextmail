# 加密Key（必填，可随意填写，需保持不变）
AUTH_SECRET = ""

# CloudFlare 部署（必填，自行获取）
CLOUDFLARE_API_TOKEN = ""
CLOUDFLARE_ACCOUNT_ID = ""
CUSTOM_DOMAIN = "mail.example.com"
NEXT_PUBLIC_BASE_URL= "https://mail.example.com"
EMAIL_DOMAIN = "example.com"
# Deployment-only WAF/API/front-end verification header (required with CUSTOM_DOMAIN; 32–128 URL-safe characters)
OPENAPI_WAF_VERIFY_SECRET = ""

# OAuth 集成（可选）
AUTH_GITHUB_ID = ""
AUTH_GITHUB_SECRET = ""
AUTH_GOOGLE_ID = ""
AUTH_GOOGLE_SECRET = ""

# 精确的可信公共 Webhook 主机名，以逗号分隔（可选）
WEBHOOK_ALLOWED_HOSTS=""

# GitHub Secrets 自动同步（可选）
REPOSITORY_URL=""
GITHUB_TOKEN=""
