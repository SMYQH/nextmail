# 必填：认证签名密钥，使用随机值并在后续部署中保持不变。
AUTH_SECRET=""

# 必填：网站公开 URL，填写实际 Worker 地址或 CUSTOM_DOMAIN；用于生成 canonical 与 hreflang 链接。
# 部署脚本在缺失时终止部署；本地开发可留空或使用 http://localhost:3000。
NEXT_PUBLIC_BASE_URL=""

# 必填：Cloudflare 部署凭据与收信 Zone（EMAIL_DOMAIN 必须与 Zone 名称完全一致）。
CLOUDFLARE_API_TOKEN=""
CLOUDFLARE_ACCOUNT_ID=""
EMAIL_DOMAIN="example.com"

# ── 以下均为可选项；留空不会覆盖已有后台配置 ──

# 自定义网站域名；留空使用 workers.dev。配置后还必须填写独立的 WAF 验证值。
CUSTOM_DOMAIN=""

# WAF 验证值：32–128 个 URL-safe 字符，与 AUTH_SECRET 不同，仅部署使用。
OPENAPI_WAF_VERIFY_SECRET=""

# 资源 ID 覆盖；留空按项目资源名称发现或创建，不能绑定其他项目资源。
DATABASE_ID=""
KV_NAMESPACE_ID=""

# OAuth：同一提供商的 ID 与 Secret 必须同时配置。
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Webhook 公共 HTTPS 主机白名单，逗号分隔，不接受通配符。
WEBHOOK_ALLOWED_HOSTS=""

# 网站设置：DEFAULT_ROLE 为 civilian / knight / duke。
# 未指定 EMAIL_DOMAINS 时，首次部署从 EMAIL_DOMAIN 初始化；升级保留后台设置。
DEFAULT_ROLE=""
EMAIL_DOMAINS=""
ADMIN_CONTACT=""

# 每个非皇帝账号的活跃邮箱上限，正安全整数（默认 30）。
MAX_EMAILS=""

# Turnstile：true / false；启用时必须同时存在 Site Key 和 Secret Key。
TURNSTILE_ENABLED=""
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# 按接收域名配置 Resend，JSON 示例：
# RESEND_CONFIG='{"example.com":{"enabled":true,"apiKey":"replace-with-resend-key"}}'
RESEND_CONFIG=""

# 每日发件限额：-1 禁止，0 不限，正数限制封数；皇帝始终不限。
# EMAIL_ROLE_LIMITS='{"duke":5,"knight":2}'
EMAIL_ROLE_LIMITS=""

# Catch-all 需包含所有接收域名；邮箱归皇帝所有，改名保留邮件。
# CATCHALL_EMAIL='{"example.com":{"address":"catch@example.com","enabled":true,"showAlways":true}}'
CATCHALL_EMAIL=""

# 可选校验 Catch-all 所有者用户名；留空使用站点现有唯一皇帝。
CATCHALL_OWNER_USERNAME=""

# 可选账号初始化/更新；只有一个账号可以为皇帝，新账号必须提供至少 8 位密码。
# 省略或空字符串字段保留原值；未列出的账号、Key 不删除。角色仅允许 emperor/duke/knight/civilian。
# allowedDomains:null 表示全部域名，[] 表示不允许任何域名；不可限制皇帝。
# apiKeys 按名称更新，新增必须提供 key；expiresAt 为 ISO 时间，新 Key 默认有效一年。
# webhook.url 必须匹配 WEBHOOK_ALLOWED_HOSTS；不发送测试邮件或 Webhook。
# ADMIN_USERS='[{"username":"admin","password":"replace-with-a-strong-password","name":"Administrator","role":"emperor","apiKeys":[{"name":"automation","key":"replace-with-a-long-random-key","enabled":true}],"webhook":{"url":"https://hooks.example.org/mail","secret":"replace-with-signing-secret","enabled":false}}]'
ADMIN_USERS=""

# GitHub Actions Secrets 自动同步：两项同时设置才启用，仅用于本地部署。
REPOSITORY_URL=""
GITHUB_TOKEN=""
